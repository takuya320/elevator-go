# syntax=docker/dockerfile:1.7

# Vite を build → nginx で静的配信。API は別オリジン (VITE_API_BASE) を直接叩く。
FROM node:22-alpine AS builder
WORKDIR /src
RUN corepack enable
COPY web/package.json web/pnpm-lock.yaml ./web/
RUN --mount=type=cache,target=/root/.local/share/pnpm/store \
    cd web && pnpm install --frozen-lockfile
COPY docs/openapi.yaml ./docs/openapi.yaml
COPY web ./web
# build 時に API オリジンを埋め込む。指定なしなら "/" にフォールバック（同一オリジン配信用）。
ARG VITE_API_BASE=""
ENV VITE_API_BASE=${VITE_API_BASE}
# 標準の build スクリプトは webdist/ を触るので、ここでは dist/ に出すコマンド列を直接叩く。
RUN cd web && \
    pnpm exec openapi-typescript ../docs/openapi.yaml -o src/api/schema.d.ts && \
    pnpm exec tsc -b && \
    pnpm exec vite build --outDir dist --emptyOutDir

FROM nginx:alpine
COPY --from=builder /src/web/dist /usr/share/nginx/html
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
